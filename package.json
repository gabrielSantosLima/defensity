{
  "name": "defensity",
  "version": "0.0.0",
  "description": "A agent based automation to detect vulnerabilities in any lib/application",
  "private": true,
  "license": "MIT",
  "author": "Gabriel Santos Lima",
  "main": "dist/main/electron/bootstrap.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron -c cyan,green \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "npm run build:main && vite build",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
